    {
      "id": 2,
      "title": "Active containers",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "darksea-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(darksea_container_running)",
          "legendFormat": "{{container}}",
          "datasource": {
            "type": "prometheus",
            "uid": "darksea-prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
